# Core Environment
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/stop_loss.db
CHECKPOINT_PATH=data/checkpoints.sqlite
EVIDENCE_PATH=data/evidence.jsonl
HTTP_TIMEOUT_SECONDS=15
INGESTION_POLL_SECONDS=300

# LangSmith Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stop-loss-terminal
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional for API keys that can access multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Vector Database Backend ('weaviate' or 'pinecone'). The team uses Pinecone (free Starter).
VECTOR_BACKEND=pinecone
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=FinancialDocument
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=stop-loss-records
# Optional: data-plane HTTPS URL. Empty = resolved from PINECONE_INDEX_NAME automatically.
PINECONE_HOST=
PINECONE_NAMESPACE=fin-terminal
# Bulk-loaded data/processed history (stop-loss-vectors backfill) lives in its own namespace.
PINECONE_HISTORY_NAMESPACE=history
# Serverless placement used by `stop-loss-vectors init` (free Starter supports aws/us-east-1).
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings Backend ('local' for sentence-transformers, 'openai' for OpenAI)
EMBEDDING_BACKEND=local
# Runs locally on the GPU (fp16) via `uv sync --extra local-embeddings`; downloaded from
# Hugging Face on first use. Changing the model/dimension requires a new Pinecone index.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
# auto = CUDA when available, else CPU
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=128
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat model for the analysis agents (routing, headline sentiment, narrative). Without
# OPENAI_API_KEY the agents fall back to deterministic, evidence-only narratives.
OPENAI_CHAT_MODEL=gpt-4.1-mini
LLM_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Order follows the eight existing graph agents. Never put real values in this file.
GROQ_COORDINATOR_API_KEY=
GROQ_MARKET_API_KEY=
GROQ_NEWS_API_KEY=
GROQ_MACRO_API_KEY=
GROQ_WEATHER_API_KEY=
GROQ_IMPACT_API_KEY=
GROQ_ANALOGS_API_KEY=
GROQ_QUANT_API_KEY=
GROQ_HEDGING_API_KEY=
GROQ_AUDIT_API_KEY=

# Terminal API (FastAPI, `uv run stop-loss-api`, binds 127.0.0.1:8000)
# Shared secret the Next.js server sends as X-Internal-Token (set the same value as
# BACKEND_INTERNAL_TOKEN in frontend/.env.local). Empty disables the check (local dev only).
API_INTERNAL_TOKEN=
CONVERSATION_DB_PATH=data/conversations.sqlite
FEEDBACK_DB_PATH=data/feedback.sqlite
RUNS_DB_PATH=data/runs.sqlite
RUN_TIMEOUT_SECONDS=150

# Market Providers
ALPHA_VANTAGE_API_KEY=
ENABLE_POLYGON=false
POLYGON_API_KEY=

# Gulf Demonstration Scenario Weather & Macro
WEATHER_LATITUDE=27.8006
WEATHER_LONGITUDE=-97.3964
WEATHER_LOCATION_NAME=Corpus Christi, Texas

NEWS_QUERY=hurricane OR refinery OR Gulf of Mexico OR tariff OR sanctions
MARKET_TICKERS=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS
YAHOO_RATE_PER_SECOND=2
QUOTE_CACHE_SECONDS=5
HISTORY_CACHE_SECONDS=300
PROFILE_CACHE_SECONDS=1800
NEWS_CACHE_SECONDS=300
SENTIMENT_CACHE_SECONDS=1800
NEWS_GDELT_ENABLED=true
MACRO_SERIES=DCOILWTICO,CPIAUCSL,FEDFUNDS

FRED_API_KEY=

# The graph uses empty stubs until real connectors are supplied.
# One of prices,macro,weather,news_tariff,news_banktax,news_war (empty = no forced failure).
STUB_FAIL_SOURCE=
STUB_FAILURE_MODE=failed
SOURCE_RATE_PER_SECOND=1
SOURCE_BURST=1
RETRY_ATTEMPTS=3
RETRY_MAX_WAIT_SECONDS=10
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_SECONDS=60
CACHE_TTL_SECONDS=60
PROCESS_BUDGET_MS=1000
# Bounded parallel embedding/indexing; queue time still counts toward the budget.
PROCESSING_CONCURRENCY=8

# Per-provider JSON overrides: alpha_vantage, fred, open_meteo.
# timeout_seconds, rate_per_second, burst, concurrency, retries; set account quotas.
CONNECTOR_POLICIES={}
FAST_POLL_SECONDS=1
MEDIA_REFRESH_SECONDS=10800
SCHEDULER_JITTER_SECONDS=30
FRESHNESS_SECONDS=60
STREAM_QUEUE_SIZE=2
INGESTION_BATCH_SIZE=32
FAST_QUEUE_POLICY=latest
SLOW_PROCESSING_CONCURRENCY=2
DEAD_LETTER_PATH=data/dead_letters.jsonl
PARSER_MAX_BYTES=8000000
LANGUAGE_HINT=
